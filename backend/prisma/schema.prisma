generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Game {
  id        Int       @id @default(autoincrement())
  movieId   Int?      @map("movie_id")
  movie     Movie?    @relation(fields: [movieId], references: [id])
  date      DateTime? @db.Date
  name  String?   @map("game_name")
  reviews   Review[]

  @@unique([date, name], map: "unique_date_per_game")
  @@map("games")  // table name in DB remains "games"
}


model Genre {
  id     Int      @id
  name   String
  movies Movie[]
  @@map("genres")
}


model Movie {
  id                Int       @id
  title             String
  originalTitle     String?   @map("original_title")
  releaseDate       DateTime  @map("release_date") @db.Date
  originalLanguage  String?   @map("original_language")
  poster        String    @map("poster_path")
  createdAt         DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime? @default(now()) @map("updated_at") @db.Timestamptz(6)
  genres            Genre[]
  games             Game[]
  @@map("movies")
}


model Review {
  id          Int      @id @default(autoincrement())
  gameId      Int      @map("game_id")
  hintNumber  Int?     @map("hint_number")
  reviewLink  String?  @map("review_link")
  reviewText  String?  @map("review_text")
  games       Game?    @relation(fields: [gameId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@unique([gameId, hintNumber])
  @@map("reviews")
}
